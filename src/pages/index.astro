---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
const domain = 'cubiletehill.com';
const attractionFullName = 'Cerro del Cubilete';
const attractionShortName = 'Cubilete Hill';
const cityName = 'Silao de la Victoria';
const cityShort = 'Silao';
const stateName = 'Guanajuato';
const countryName = 'México';
const govtTourismUrl = 'https://guanajuato.mx/';
const govtTourismLabel = 'Información turística de Guanajuato';
const mapsShareUrl = 'https://maps.app.goo.gl/AYYQ49U1srAz49sE8';
const sanctuaryUrl = 'https://santuariodecristorey.org/';
const contactUrl = 'https://santuariodecristorey.org/contacto-electronico/';
const siteRoot = (Astro.site ?? new URL(`https://${domain}`)).href.replace(/\/$/, '');
const title = 'Cerro del Cubilete: horario de Cristo Rey, altitud y cómo llegar';
const description = 'Planea la visita al Cerro del Cubilete en Silao, Guanajuato: distingue el horario del Santuario de Cristo Rey, consulta la ubicación, altitud y opciones de transporte.';
const canonical = new URL('/', Astro.site ?? siteRoot).href;
const ogImage = `${siteRoot}/og-card.png`;
const landscapeImage = `${siteRoot}/images/cerro-cubilete-camino.webp`;
const coords = { latitude: 21.0119341, longitude: -101.3684356 };
const faqs = [
  {
    "q": "¿Cuál es el horario del Cerro del Cubilete y del Santuario de Cristo Rey?",
    "a": "La web del Santuario de Cristo Rey publica apertura de 06:00 a 20:00. Es una referencia del recinto religioso, no un horario garantizado para toda la montaña ni cada camino. La ficha de Google Maps de Cubilete Hill consultada el 29 de octubre de 2026 muestra apertura el viernes a las 08:00. Como son fichas y ámbitos distintos, confirma con el santuario antes de salir; no uses el horario de misas como horario de visita."
  },
  {
    "q": "¿Dónde está el Cerro del Cubilete y qué altitud tiene?",
    "a": "Está en Silao de la Victoria, Guanajuato, México. La promoción turística de Guanajuato indica una altitud aproximada de 2.579 metros sobre el nivel del mar. El enlace del mapa corresponde a la ficha de la montaña; no señala por sí solo un estacionamiento o una entrada accesible."
  },
  {
    "q": "¿El Cerro del Cubilete es lo mismo que Cristo Rey?",
    "a": "El cerro es la montaña; el Santuario Votivo Nacional de Cristo Rey y su monumento están en la cima. Sus accesos y servicios tienen condiciones propias: una ficha del cerro no sustituye la información del recinto religioso."
  },
  {
    "q": "¿Cuánto cuesta la visita?",
    "a": "No hemos confirmado una tarifa vigente del recinto en las fuentes del santuario consultadas. Pregunta por las condiciones de entrada y por cualquier servicio aparte. Transporte, alimentos y estacionamiento pueden tener costos independientes; esta guía no vende entradas ni excursiones."
  },
  {
    "q": "¿Cómo llegar desde Silao, Guanajuato o León?",
    "a": "Planifica la ruta hacia el Santuario de Cristo Rey en la cima, siguiendo los accesos señalizados. El camino incluye curvas y pendientes. Comprueba el estado de la carretera y acuerda el regreso con tu conductor; un punto del mapa no garantiza llegar en vehículo hasta la puerta."
  },
  {
    "q": "¿Hay autobús hasta el Cubilete?",
    "a": "Ecocubilete menciona corridas desde las terminales de Silao y Guanajuato, pero la información de tarifa está fechada en 2022. No hemos confirmado horarios, precio ni punto final actuales. Pregunta en la terminal por la Corrida al Cubilete y verifica dónde te dejará y cómo volverás antes de comprar."
  },
  {
    "q": "¿Hay estacionamiento y acceso sin escalones?",
    "a": "No hemos confirmado cupos, tarifas ni un itinerario continuo sin escalones. Si necesitas reducir caminatas o evitar pendientes, consulta con el santuario el punto de descenso, las rampas disponibles y el acceso al templo para tu fecha. El nuevo arco de acceso se encuentra al inicio de un recorrido de unos 800 metros al santuario, según el Gobierno de Guanajuato; no es una garantía de accesibilidad."
  },
  {
    "q": "¿Cuánto tiempo reservar?",
    "a": "Como orientación de esta guía, reserva unas dos horas para una visita tranquila a la explanada y el recinto, además del transporte. Una misa, una peregrinación, la caminata final o las esperas pueden ampliar ese tiempo; no es una duración oficial."
  },
  {
    "q": "¿Cómo llegar desde el aeropuerto del Bajío (BJX)?",
    "a": "El operador GAP publica servicios de taxis y UNEBUS en el Aeropuerto Internacional de Guanajuato. Confirma el destino del autobús y, para llegar a la cima, acuerda los transbordos o un traslado con regreso. El directorio del aeropuerto no acredita un autobús directo al santuario."
  },
  {
    "q": "¿Qué llevar por la altura y el clima?",
    "a": "Lleva agua, protección solar, calzado que sujete bien y una capa para el viento o el frío. Revisa el pronóstico y las condiciones del camino antes de salir. La niebla o la lluvia pueden reducir la visibilidad; no cuentes con vistas despejadas por el mes de tu viaje."
  }
];
const sources = [
  {
    "label": "Santuario de Cristo Rey · apertura",
    "href": "https://santuariodecristorey.org/",
    "note": "La portada publica 06:00–20:00 para el santuario; consultada el 29 de octubre de 2026."
  },
  {
    "label": "Santuario · misas",
    "href": "https://santuariodecristorey.org/servicio-liturgico-y-espirituales/horario-de-misas/",
    "note": "El horario litúrgico es distinto del acceso de visitantes. La portada y esta página no enumeran las mismas misas dominicales; confirma tu celebración."
  },
  {
    "label": "Santuario · historia",
    "href": "https://santuariodecristorey.org/historia/",
    "note": "Construcción del monumento actual desde 1944; bendición de la estatua en 1950."
  },
  {
    "label": "Santuario · contacto",
    "href": "https://santuariodecristorey.org/contacto-electronico/",
    "note": "Canal publicado por el propio recinto para confirmar visita y servicios."
  },
  {
    "label": "Guanajuato · orientación turística",
    "href": "https://guanajuato.mx/blog/imperdibles/visita-cristo-rey-en-semana-santa-una-experiencia-espiritual-en-el-cerro-del-cubilete/",
    "note": "Publicación del 10 de marzo de 2026: ubicación, altura y accesos por carretera."
  },
  {
    "label": "Gobierno de Guanajuato · nuevo acceso",
    "href": "https://boletines.guanajuato.gob.mx/2026/08/29/entrega-gobierno-de-la-gente-nuevo-arco-y-explanada-en-la-subida-al-cerro-del-cubilete/",
    "note": "Entrega del arco y explanada el 29 de agosto de 2026; recorrido aproximado de 800 m al santuario."
  },
  {
    "label": "Ecocubilete · transporte",
    "href": "https://ecocubilete.net/bosque/ubicacion-del-bosque/",
    "note": "Menciona corridas al Cubilete; tarifa fechada en 2022, no utilizada como precio vigente."
  },
  {
    "label": "GAP · transporte del aeropuerto",
    "href": "https://aeropuertosgap.com.mx/es/guanajuato/servicios/transportacion-terrestre.html",
    "note": "Directorio del operador aeroportuario: taxis y UNEBUS; confirma recorridos directamente."
  },
  {
    "label": "Ficha de Cubilete Hill en Google Maps",
    "href": "https://maps.app.goo.gl/AYYQ49U1srAz49sE8",
    "note": "4,8/5 y 16.661 opiniones; consulta del 29 de octubre de 2026. Datos de terceros, no opiniones de esta guía."
  },
  {
    "label": "Open-Meteo · datos meteorológicos",
    "href": "https://open-meteo.com/",
    "note": "Pronóstico orientativo del punto del mapa; no es un parte de accesibilidad o carreteras."
  }
];
const transport = [
  {
    "kind": "Desde Silao",
    "title": "Ascenso hacia Cristo Rey",
    "detail": "Elige el acceso señalizado hacia el santuario, revisa el recorrido completo y acuerda la vuelta antes de subir. Evita confundir el pin de la montaña con una puerta o zona de estacionamiento.",
    "meta": "Carretera de montaña · curvas y pendientes"
  },
  {
    "kind": "Desde Guanajuato o León",
    "title": "Calcula el trayecto según tu salida",
    "detail": "La promoción turística de Guanajuato describe accesos por carretera desde ambas ciudades. Consulta la ruta del día y añade margen para tráfico, lluvia o peregrinaciones; no usamos un tiempo fijo como garantía.",
    "meta": "Comprueba el acceso antes de viajar",
    "href": "https://guanajuato.mx/blog/imperdibles/visita-cristo-rey-en-semana-santa-una-experiencia-espiritual-en-el-cerro-del-cubilete/",
    "linkLabel": "Orientación turística de Guanajuato"
  },
  {
    "kind": "Autobús",
    "title": "Pregunta por la Corrida al Cubilete",
    "detail": "Ecocubilete menciona viajes desde las terminales de Silao y Guanajuato. Su referencia de tarifa es de 2022: confirma la operación actual, punto de bajada y último regreso en la terminal.",
    "meta": "Sin frecuencia ni tarifa vigente confirmadas",
    "href": "https://ecocubilete.net/bosque/ubicacion-del-bosque/",
    "linkLabel": "Leer la referencia de Ecocubilete"
  },
  {
    "kind": "Aeropuerto BJX",
    "title": "Traslado desde el Aeropuerto de Guanajuato",
    "detail": "GAP publica taxis y UNEBUS. Verifica el destino y las conexiones: esa oferta no demuestra una conexión directa a la cima. Para un traslado contratado, acuerda por adelantado regreso y punto de encuentro.",
    "meta": "Directorio del operador aeroportuario",
    "href": "https://aeropuertosgap.com.mx/es/guanajuato/servicios/transportacion-terrestre.html",
    "linkLabel": "Ver transporte terrestre de GAP"
  }
];
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${siteRoot}/#website`, url: siteRoot, name: 'Cerro del Cubilete · guía independiente', description, inLanguage: 'es-MX' },
    { '@type': 'TouristAttraction', '@id': `${siteRoot}/#attraction`, name: attractionFullName, alternateName: attractionShortName, url: canonical, description, image: landscapeImage, address: { '@type': 'PostalAddress', addressLocality: cityName, addressRegion: stateName, addressCountry: 'MX' }, geo: { '@type': 'GeoCoordinates', ...coords }, hasMap: mapsShareUrl },
    { '@type': 'Place', '@id': `${siteRoot}/#sanctuary`, name: 'Santuario Votivo Nacional de Cristo Rey', url: sanctuaryUrl, containedInPlace: { '@id': `${siteRoot}/#attraction` } },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: attractionFullName, item: canonical }] },
    { '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) }
  ]
};
const mapSrc = `https://www.google.com/maps?q=${coords.latitude},${coords.longitude}&z=15&output=embed`;
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#181713" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" hreflang="es-MX" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="preload" as="image" href="/images/cubilete-abstract.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- Geolocalización explícita del ente físico (NAP + coordenadas) -->
    <meta name="geo.region" content="MX-GUA" />
    <meta name="geo.placename" content={`${cityName}, ${stateName}`} />
    <meta name="geo.position" content={`${coords.latitude};${coords.longitude}`} />
    <meta name="ICBM" content={`${coords.latitude}, ${coords.longitude}`} />
    <!-- Open Graph (vinculación de entidad) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={`${attractionFullName} (${attractionShortName})`} />
    <meta property="og:title" content={`${attractionFullName} (${attractionShortName}) — ${cityShort}, ${stateName}`} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${attractionFullName} (${attractionShortName}) en ${cityShort}, ${stateName}, ${countryName}`} />
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${attractionFullName} (${attractionShortName}) — ${cityShort}, ${stateName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${attractionFullName} (${attractionShortName}) en ${cityShort}, ${stateName}`} />
    <!-- Iconos -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={attractionFullName} />
    <meta name="application-name" content={attractionFullName} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)}></script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
  </head>
  <body>
    <header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-[#181713]/90 text-white backdrop-blur-md">
      <div class="container-shell flex min-h-18 items-center justify-between gap-6">
        <Logo light compact />
        <nav class="hidden items-center gap-7 text-[.72rem] font-bold uppercase tracking-[.13em] md:flex" aria-label="Navegación principal">
          <a class="transition hover:text-[#d2ad6c]" href="#historia">Historia</a>
          <a class="transition hover:text-[#d2ad6c]" href="#planea">Planea</a>
          <a class="transition hover:text-[#d2ad6c]" href="#llegar">Cómo llegar</a>
          <a class="transition hover:text-[#d2ad6c]" href="#clima">Clima</a>
          <a class="transition hover:text-[#d2ad6c]" href="#alrededores">Alrededores</a>
          <a class="transition hover:text-[#d2ad6c]" href="#faq">FAQ</a>
        </nav>
        <a href="https://maps.app.goo.gl/AYYQ49U1srAz49sE8" rel="noopener noreferrer" target="_blank" class="border border-[#a57637] px-4 py-2 text-[.7rem] font-bold uppercase tracking-[.12em] text-[#f2eadc] transition hover:bg-[#a57637] hover:text-[#181713]">Abrir mapa</a>
      </div>
      <details class="mobile-nav md:hidden"><summary>Secciones de la guía</summary><nav aria-label="Navegación móvil"><a href="#planea">Horario y visita</a><a href="#llegar">Cómo llegar</a><a href="#historia">Historia</a><a href="#clima">Clima</a><a href="#faq">Preguntas</a><a href="#fuentes">Fuentes</a></nav></details>
    </header>

    <main id="inicio">
      <section class="hero-photo deco-frame relative flex min-h-[92svh] items-end overflow-hidden text-white">
        <div class="container-shell relative z-10 pb-16 pt-44 md:pt-36 md:pb-24">
          <div class="grid items-end gap-10 md:grid-cols-[1fr_320px]">
            <div>
              <nav aria-label="Ruta de navegación" class="mb-6 text-[.68rem] font-semibold uppercase tracking-[.15em] text-white/55">
                <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
                  <li><a class="hover:text-[#d2ad6c]" href="#inicio">Inicio</a></li>
                  <li aria-hidden="true">/</li>
                  <li><a class="hover:text-[#d2ad6c]" href="https://www.gob.mx/" target="_blank" rel="noopener noreferrer">{countryName}</a></li>
                  <li aria-hidden="true">/</li>
                  <li><a class="hover:text-[#d2ad6c]" href={govtTourismUrl} target="_blank" rel="noopener noreferrer">{stateName}</a></li>
                  <li aria-hidden="true">/</li>
                  <li>{cityName}</li>
                  <li aria-hidden="true">/</li>
                  <li class="text-[#d2ad6c]">{attractionFullName}</li>
                </ol>
              </nav>
              <p class="eyebrow mb-5 text-[#d2ad6c]">Silao de la Victoria · Guanajuato · México</p>
              <h1 class="max-w-4xl text-[clamp(3.4rem,8.6vw,8rem)] leading-[.8] text-[#f5eee2]">
                Cerro del<br/><span class="italic text-[#d2ad6c]">Cubilete</span>
                <span class="mt-5 block text-[clamp(1.05rem,2.2vw,1.75rem)] font-normal not-italic leading-tight tracking-normal text-white/75">(Cubilete Hill) — {cityShort}, {stateName}, {countryName}</span>
              </h1>
              <p class="mt-8 max-w-2xl text-lg leading-8 text-white/78">El <strong class="font-semibold text-white">Cerro del Cubilete</strong> es la montaña de Silao donde se encuentra el <strong class="font-semibold text-white">Santuario de Cristo Rey</strong>. Consulta qué horario corresponde al recinto, cómo organizar el ascenso y qué confirmar antes de viajar.</p>
            </div>
            <aside class="border-l border-[#d2ad6c]/50 pl-6 text-[#f2eadc]">
              <p class="text-5xl display">4.8<span class="text-xl text-[#d2ad6c]">/5</span></p>
              <p class="mt-1 text-sm text-white/60"><a href={mapsShareUrl} target="_blank" rel="noopener noreferrer" class="underline">16.661 opiniones en Google Maps</a><br/>Consulta: 29 de octubre de 2026</p>
              <div class="mt-7 grid grid-cols-2 gap-y-5 text-sm">
                <div><p class="eyebrow text-[#d2ad6c]">Altitud</p><p class="mt-1 text-lg">2,579 m</p></div>
                <div><p class="eyebrow text-[#d2ad6c]">Ubicación</p><p class="mt-1 text-lg">Silao, Guanajuato</p></div>
                <div><p class="eyebrow text-[#d2ad6c]">Horario*</p><p class="mt-1 text-lg">06:00–20:00</p></div>
                <div><p class="eyebrow text-[#d2ad6c]">Visita</p><p class="mt-1 text-lg">Confirma el acceso</p></div>
              </div>
              <p class="mt-5 text-xs leading-5 text-white/50">*La <a href={sanctuaryUrl} target="_blank" rel="noopener noreferrer" class="underline">web del santuario</a> publica 06:00–20:00. Maps muestra viernes 08:00 para la ficha de la montaña. Son referencias distintas; confirma antes de salir. Consultadas el 29 de octubre de 2026.</p>
            </aside>
          </div>
          <p class="hero-credit mt-8 text-xs">Ilustración abstracta original de montaña; no es una fotografía ni representa un acceso real.</p>
        </div>
      </section>

      <section id="historia" class="bg-[#f2eadc] py-24 md:py-32">
        <div class="container-shell grid gap-14 md:grid-cols-[.9fr_1.1fr] md:items-start">
          <div class="md:sticky md:top-28">
            <p class="eyebrow bronze-text">Entre el Bajío y el cielo</p>
            <h2 class="mt-4 max-w-xl text-5xl leading-[.96] md:text-7xl">Historia y significado del Cerro del Cubilete: un santuario hecho para verse desde lejos.</h2>
            <div class="mt-9 h-px w-28 bg-[#a57637]"></div>
          </div>
          <div class="space-y-8 text-[1.05rem] leading-8 text-[#38352d]">
            <p class="text-2xl leading-9 display">En la cima del Cerro del Cubilete, el Santuario de Cristo Rey convierte la llegada en una experiencia de escala: primero la montaña, luego la explanada y, finalmente, la figura de brazos abiertos sobre la cúpula.</p>
            <p>La devoción en este cerro se remonta a las primeras décadas del siglo XX. Según la <a href="https://santuariodecristorey.org/historia/" target="_blank" rel="noopener noreferrer" class="underline">historia del santuario</a>, el monumento actual comenzó a construirse en 1944 y la estatua fue bendecida en 1950. Es el quinto de los monumentos de esta devoción descritos por el recinto, no el quinto levantado en esta misma cima.</p>
            <p>La cima se encuentra a unos <strong>2,579 metros sobre el nivel del mar</strong>. Desde allí, en días despejados, la vista se extiende sobre las sierras y llanuras del centro de Guanajuato. El ascenso forma parte de la visita: carretera de montaña, cambios de paisaje y una llegada que se abre de golpe hacia la explanada.</p>
            <blockquote class="mt-12 border-y border-[#a57637]/40 py-9">
              <span class="quote-mark">“</span>
              <p class="mt-4 text-3xl leading-10 display italic">Más que un mirador: una cima donde paisaje, memoria y peregrinación comparten el mismo horizonte.</p>
            </blockquote>
          </div>
        </div>
      </section>

      <section class="bg-[#181713] py-16 text-[#f2eadc] md:py-24" aria-label="Galería fotográfica">
        <div class="container-shell">
          <div class="mb-9 flex items-end justify-between gap-6">
            <div><p class="eyebrow text-[#d2ad6c]">Miradas del Cubilete</p><h2 class="mt-2 text-4xl md:text-5xl">Una mirada histórica al camino</h2></div>
            <p class="hidden max-w-sm text-right text-sm leading-6 text-white/50 md:block">Fotografía de Wikimedia Commons. Autoría y licencia junto a la imagen. No muestra las condiciones actuales del camino.</p>
          </div>
          <div class="photo-gallery">
            <figure class="photo-figure"><img src="/images/cerro-cubilete-camino.webp" width="1600" height="900" alt="Camino empedrado hacia el Cubilete con autobuses a distancia, fotografiado en 2020" loading="lazy" decoding="async" /><figcaption><p>El camino de ascenso · fotografía histórica</p><PhotoCredit /></figcaption></figure>
          </div>
        </div>
      </section>

      <section id="planea" class="bg-[#fbf6ed] py-24 md:py-32">
        <div class="container-shell">
          <p class="eyebrow bronze-text">Planea tu visita</p>
          <div class="mt-4 grid gap-10 lg:grid-cols-[.82fr_1.18fr]">
            <h2 class="text-5xl leading-[.98] md:text-7xl">Lo útil antes de empezar la subida.</h2>
            <div class="grid gap-px bg-[#a57637]/25 sm:grid-cols-2">
              <article class="bg-[#fbf6ed] p-7 md:p-9"><p class="eyebrow bronze-text">01 · Entrada / costo</p><h3 class="mt-3 text-3xl">Confirma las condiciones</h3><p class="mt-4 leading-7 text-[#575247]">No hemos confirmado una tarifa vigente en las fuentes del santuario consultadas. Pregunta por el acceso al recinto y presupuesta aparte transporte, comida y servicios que utilices.</p></article>
              <article class="bg-[#fbf6ed] p-7 md:p-9"><p class="eyebrow bronze-text">02 · Horario del santuario</p><h3 class="mt-3 text-3xl">06:00–20:00, según su web</h3><p class="mt-4 leading-7 text-[#575247]">La portada oficial publica este horario del recinto. La ficha de la montaña en Maps muestra apertura el viernes a las 08:00. No son garantías equivalentes: confirma tu visita y consulta las misas por separado.</p></article>
              <article class="bg-[#fbf6ed] p-7 md:p-9"><p class="eyebrow bronze-text">03 · Duración sugerida</p><h3 class="mt-3 text-3xl">Unas dos horas</h3><p class="mt-4 leading-7 text-[#575247]">Orientación de esta guía, además del transporte. Añade margen si asistirás a misa, caminarás desde el arco o viajas en una peregrinación; no es una duración oficial.</p></article>
              <article class="bg-[#fbf6ed] p-7 md:p-9"><p class="eyebrow bronze-text">04 · Estacionamiento</p><h3 class="mt-3 text-3xl">Consulta dónde bajar</h3><p class="mt-4 leading-7 text-[#575247]">No hemos confirmado cupos, tarifas ni acceso continuo sin escalones. Pregunta por el punto de descenso y las rampas si necesitas reducir caminatas. El Gobierno estatal sitúa el nuevo arco al comienzo de unos 800 m hacia el santuario.</p></article>
            </div>
          </div>
          <div class="mt-12 grid gap-5 rounded-sm bg-[#914c35] p-7 text-[#fff8ec] md:grid-cols-[auto_1fr_auto] md:items-center md:p-9">
            <div class="text-4xl">↗</div>
            <div><p class="eyebrow text-[#edc991]">Antes de salir</p><p class="mt-1 text-lg">Confirma horarios litúrgicos y avisos especiales directamente con el Santuario de Cristo Rey.</p></div>
            <a class="w-fit border border-white/50 px-5 py-3 text-xs font-bold uppercase tracking-[.13em] hover:bg-white hover:text-[#914c35]" href={contactUrl} target="_blank" rel="noopener noreferrer">Contacto oficial</a>
