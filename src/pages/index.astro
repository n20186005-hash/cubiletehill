      <section class="bg-[#181713] py-14 text-[#f2eadc]">
        <div class="container-shell grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
          <div><p class="eyebrow text-[#d2ad6c]">Tu siguiente paso</p><h2 class="mt-2 text-4xl">Guarda la ruta antes de subir.</h2></div>
          <div class="flex flex-wrap gap-3"><a class="bg-[#d2ad6c] px-6 py-3 text-xs font-bold uppercase tracking-[.12em] text-[#181713]" href="https://maps.app.goo.gl/AYYQ49U1srAz49sE8" target="_blank" rel="noopener noreferrer">Ver en Google Maps</a><a class="border border-white/30 px-6 py-3 text-xs font-bold uppercase tracking-[.12em]" href={contactUrl} target="_blank" rel="noopener noreferrer">Consultar al santuario</a></div>
        </div>
      </section>
    </main>

    <footer class="bg-[#11110f] py-10 text-white/55">
      <div class="container-shell flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <div>
          <Logo light />
          <address class="mt-6 not-italic text-xs leading-6 text-white/60">
            <p class="text-sm font-semibold text-[#f2eadc]">{attractionFullName} ({attractionShortName})</p>
            <p>{cityName}, {stateName}, {countryName}</p>
            <p><a class="underline" href={contactUrl} target="_blank" rel="noopener noreferrer">Contacto publicado por el santuario</a></p>
          </address>
          <p class="mt-5 max-w-xl text-xs leading-5">Guía turística y de divulgación cultural sin fines de lucro, independiente, no oficial y no afiliada al Santuario de Cristo Rey, a Google ni al Gobierno de Guanajuato. Verifica horarios, accesos y condiciones directamente con los operadores correspondientes antes de viajar.</p>
        </div>
        <div class="max-w-md text-xs leading-5 md:text-right">
          <p>Foto del camino: <a class="underline" href="https://commons.wikimedia.org/wiki/File:Camino_al_Cerro_del_Cubilete_2020_05.jpg" target="_blank" rel="noopener noreferrer">Isaacvp · Wikimedia Commons</a> · <a class="underline" href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a>. La portada utiliza una ilustración abstracta original.</p>
          <p class="mt-3">Privacidad: esta página carga Google Analytics para estadísticas de uso; el mapa usa Google Maps y el pronóstico solicita datos a Open-Meteo. Estos proveedores reciben datos de conexión. No hay formularios, cuentas ni reservas. Consulta <a class="underline" href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">la privacidad de Google</a> y <a class="underline" href="https://open-meteo.com/en/terms" target="_blank" rel="noopener noreferrer">Open-Meteo</a>.</p>
          <p class="mt-2">Revisión de las fuentes citadas: 29 de octubre de 2026. Las fotografías son históricas y no acreditan condiciones actuales.</p>
        </div>
      </div>
    </footer>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
    <script is:inline>
      (function () {
        var root = document.getElementById('weather-root');
        if (!root) return;
        var wmo = {
          0:['Despejado','☀️'],1:['Mayormente despejado','🌤️'],2:['Parcialmente nublado','⛅'],3:['Nublado','☁️'],
          45:['Niebla','🌫️'],48:['Niebla con escarcha','🌫️'],
          51:['Llovizna ligera','🌦️'],53:['Llovizna','🌦️'],55:['Llovizna intensa','🌧️'],
          56:['Llovizna helada','🌧️'],57:['Llovizna helada intensa','🌧️'],
          61:['Lluvia ligera','🌦️'],63:['Lluvia','🌧️'],65:['Lluvia intensa','🌧️'],
          66:['Lluvia helada','🌧️'],67:['Lluvia helada intensa','🌧️'],
          71:['Nieve ligera','🌨️'],73:['Nieve','🌨️'],75:['Nieve intensa','❄️'],77:['Granizo menudo','🌨️'],
          80:['Chubascos','🌦️'],81:['Chubascos','🌧️'],82:['Chubascos intensos','⛈️'],
          85:['Nieve dispersa','🌨️'],86:['Nieve dispersa intensa','❄️'],
          95:['Tormenta','⛈️'],96:['Tormenta con granizo','⛈️'],99:['Tormenta con granizo intensa','⛈️']
        };
        function label(c){ return wmo[c] || ['—','🌡️']; }
        var dias = ['dom','lun','mar','mié','jue','vie','sáb'];
        var url = 'https://api.open-meteo.com/v1/forecast?latitude=21.0119341&longitude=-101.3684356&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max&timezone=America/Mexico_City&forecast_days=7&wind_speed_unit=kmh';
        fetch(url).then(function(r){ if (!r.ok) throw new Error("weather-http"); return r.json(); }).then(function(d){
          if (!d.current || !d.daily || !["temperature_2m", "relative_humidity_2m", "apparent_temperature", "weather_code", "wind_speed_10m"].every(function(k){ return Number.isFinite(d.current[k]); }) || !Array.isArray(d.daily.time) || d.daily.time.length === 0 || !["weather_code", "temperature_2m_max", "temperature_2m_min"].every(function(k){ return Array.isArray(d.daily[k]) && d.daily[k].length === d.daily.time.length && d.daily[k].every(Number.isFinite); })) throw new Error("weather-data");
          var cur = d.current; var lc = label(cur.weather_code);
          var html = '<div class="flex items-end justify-between gap-6 border-b border-[#a57637]/25 pb-6">';
          html += '<div><p class="text-6xl display leading-none">' + Math.round(cur.temperature_2m) + '°</p>';
          html += '<p class="mt-2 text-lg">' + lc[1] + ' ' + lc[0] + '</p></div>';
          html += '<div class="text-right text-sm text-white/65 space-y-1">';
          html += '<p>Sensación: ' + Math.round(cur.apparent_temperature) + '°</p>';
          html += '<p>Humedad: ' + cur.relative_humidity_2m + '%</p>';
          html += '<p>Viento: ' + Math.round(cur.wind_speed_10m) + ' km/h</p></div></div>';
          html += '<div class="weather-days mt-6">';
          var dd = d.daily;
          for (var i = 0; i < dd.time.length; i++) {
            var dt = new Date(dd.time[i] + 'T00:00:00');
            var dl = label(dd.weather_code[i]);
            html += '<div class="px-1">';
            html += '<p class="text-[.68rem] uppercase tracking-[.08em] text-white/45">' + (i === 0 ? 'hoy' : dias[dt.getDay()]) + '</p>';
            html += '<p class="my-2 text-xl">' + dl[1] + '</p>';
            html += '<p class="text-sm font-semibold">' + Math.round(dd.temperature_2m_max[i]) + '°</p>';
            html += '<p class="text-xs text-white/50">' + Math.round(dd.temperature_2m_min[i]) + '°</p>';
            html += '</div>';
          }
          html += '</div>';
          root.innerHTML = html;
        }).catch(function(){
          root.innerHTML = '<p class="text-sm text-white/55">No se pudo cargar el pronóstico en este momento. Revisa el clima antes de subir al cerro.</p>';
        });
      })();
    </script>
  </body>
</html>
