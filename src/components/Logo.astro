---
interface Props { light?: boolean; compact?: boolean; }
const { light = false, compact = false } = Astro.props;
---
<a href="#inicio" class="inline-flex items-center gap-3" aria-label="Cerro del Cubilete — inicio">
  <svg viewBox="0 0 64 64" width={compact ? 34 : 42} height={compact ? 34 : 42} aria-hidden="true">
    <circle cx="32" cy="32" r="30" fill="none" stroke={light ? '#d2ad6c' : '#a57637'} stroke-width="1.5"/>
    <path d="M32 11v25M18 22h28" stroke={light ? '#f2eadc' : '#181713'} stroke-width="4" stroke-linecap="round"/>
    <path d="M12 46h40M16 46c3-8 9-12 16-12s13 4 16 12" fill="none" stroke={light ? '#d2ad6c' : '#a57637'} stroke-width="3" stroke-linecap="round"/>
    <path d="M21 50h22" stroke={light ? '#f2eadc' : '#181713'} stroke-width="2" stroke-linecap="round"/>
  </svg>
  <span class:list={["leading-none", light ? "text-[#f2eadc]" : "text-[#181713]"]}>
    <span class="block display text-[1.05rem] tracking-[-.02em]">Cerro del Cubilete</span>
    {!compact && <span class="mt-1 block text-[.62rem] font-bold uppercase tracking-[.16em] text-[#a57637]">Silao · Guanajuato</span>}
  </span>
</a>
